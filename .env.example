# ===========================================
# MERNverse Environment Configuration
# ===========================================
# Copy this file to .env and update the values
# DO NOT commit .env to version control

# Session Configuration
# IMPORTANT: Generate a strong random secret for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-secret-in-production

# CORS Configuration
# Set to your frontend domain in production (e.g., https://yourdomain.com)
# Use * for development only
CORS_ORIGIN=*

# MongoDB Configuration (optional - docker-compose sets defaults)
# MONGO_URI=mongodb://mernverse-mongo:27017/mernverse

# Port Configuration
# PORT=8096
